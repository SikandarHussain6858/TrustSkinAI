# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Testing & linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Datasets (MedIMeta downloads — never commit raw data)
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model weights & checkpoints
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx

# Generated outputs (regenerate via scripts/)
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
